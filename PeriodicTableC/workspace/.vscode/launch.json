{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET Core Attach",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickProcess}",
      "justMyCode": true
    },
    {
      "name": ".NET Core Launch (web)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Build Periodic Table Project",
      "program": "${workspaceFolder}/PeriodicTableWeb/bin/Debug/net8.0/PeriodicTableWeb.dll",
      "args": [],
      "cwd": "${workspaceFolder}/PeriodicTableWeb",
      "stopAtEntry": false,
      "serverReadyAction": {
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "{url}",
        "action": "openExternally"
      }
    }
  ]
}
