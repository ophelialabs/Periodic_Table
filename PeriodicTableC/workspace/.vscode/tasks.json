{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Periodic Table Project",
      "command": "dotnet",
      "type": "shell",
      "args": [
        "build"
      ],
      "problemMatcher": [
        "$msCompile"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Run Periodic Table (Watch Mode)",
      "command": "dotnet",
      "type": "shell",
      "args": [
        "watch",
        "run",
        "--project",
        "PeriodicTableWeb/PeriodicTableWeb.csproj"
      ],
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*",
          "endsPattern": ".*Now listening on.*"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Restore NuGet Packages",
      "command": "dotnet",
      "type": "shell",
      "args": [
        "restore"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Clean Build",
      "command": "dotnet",
      "type": "shell",
      "args": [
        "clean"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
